<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Installable on Google TV / Android TV (no touchscreen) and on phones. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Android 11+ package visibility: detect Nuvio and streaming apps for the provider buttons. -->
    <queries>
        <!-- Voice search: without these, Android 11+ hides the speech apps and the mic button never shows. -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <package android:name="com.google.android.tts" />
        <package android:name="com.google.android.katniss" />
        <package android:name="com.google.android.googlequicksearchbox" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="nuvio" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <package android:name="com.netflix.ninja" />
        <package android:name="com.netflix.mediaclient" />
        <package android:name="com.amazon.amazonvideo.livingroom" />
        <package android:name="com.amazon.avod.thirdpartyclient" />
        <package android:name="in.startv.hotstar" />
        <package android:name="in.startv.hotstaronly" />
        <package android:name="io.gh.reisxd.tizentube.cobalt" />
        <package android:name="com.google.android.youtube.tv" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.graymatrix.did" />
        <package android:name="com.sonyliv" />
        <package android:name="com.suntv.sunnxt" />
        <package android:name="com.mmtv.manoramamax.android" />
        <package android:name="com.apple.atve.androidtv.appletv" />
        <package android:name="com.jio.media.ondemand" />
    </queries>

    <application
        android:label="Padampetti"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
